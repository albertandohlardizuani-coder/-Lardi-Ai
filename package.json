"use client";
import { useState, useEffect, useRef } from "react";

export default function Page() {
  const [q, setQ] = useState("");
  const [chats, setChats] = useState<any[]>([]);
  const [memories, setMemories] = useState<any[]>([]);
  const [goal, setGoal] = useState("");
  const [showSet, setShowSet] = useState(false);
  const [liveDate, setLiveDate] = useState("");
  const [liveTime, setLiveTime] = useState("");
  // ============================================
  // 🔑 PUT YOUR KEYS HERE Boss! 👇👇👇
  // ============================================
  const [groqKey, setGroqKey] = useState("gsk_YOUR_GROQ_KEY_HERE"); // 👈 PUT GROQ KEY HERE - 
  const [geminiKey, setGeminiKey] = useState("AIzaSy_YOUR_GEMINI_KEY_HERE"); // 👈 PUT GEMINI KEY HERE - 
  // ============================================
  const chatEndRef = useRef<HTMLDivElement>(null);

  const cleanAIAnswer = (text: string) => {
    if (!text) return "";
    let t = text;
    t = t.replace(/\*\*\*(.*?)\*\*\*/g, "$1").replace(/\*\*(.*?)\*\*/g, "$1").replace(/__/g, "").replace(/`/g, "").replace(/\|/g, " ").replace(/:::/g, "").replace(/#{1,6}\s*/gm, "").replace(/[¥™℅°`\\=]+/g, " ").replace(/\*\*/g, "").replace(/\*/g, "").replace(/\|---/g, " ").replace(/---/g, " ").replace(/\s{2,}/g, " ");
    return t.trim();
  };

  useEffect(() => {
    const h = JSON.parse(localStorage.getItem("lardi_si_history") || "[]");
    const m = JSON.parse(localStorage.getItem("lardi_si_knowledge") || "[]");
    const g = localStorage.getItem("lardi_si_goal") || "";
    const gk = localStorage.getItem("lardi_groq_key") || "gsk_YOUR_GROQ_KEY_HERE";
    const gm = localStorage.getItem("lardi_gemini_key") || "AIzaSy_YOUR_GEMINI_KEY_HERE";
    // If you hardcoded keys above, use them
    if(gk.includes("YOUR")){} else { setGroqKey(gk); }
    if(gm.includes("YOUR")){} else { setGeminiKey(gm); }
    setChats(h); setMemories(m); setGoal(g);
    setTimeout(()=>{ const el=document.getElementById("splash"); if(el) el.style.display="none"; },900);
    const updateTime = () => {
      const now = new Date();
      setLiveDate(now.toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric',timeZone:'Africa/Accra'}));
      setLiveTime(now.toLocaleTimeString('en-US',{hour:'2-digit',minute:'2-digit',second:'2-digit',hour12:true,timeZone:'Africa/Accra'}));
    };
    updateTime();
    const int = setInterval(updateTime,1000);
    return ()=>clearInterval(int);
  }, []);

  useEffect(()=>{ chatEndRef.current?.scrollIntoView({behavior:"smooth"}); }, [chats]);
  const save = (newChats:any[], newMems:any[]) => {
    localStorage.setItem("lardi_si_history", JSON.stringify(newChats.slice(-100)));
    localStorage.setItem("lardi_si_knowledge", JSON.stringify(newMems.slice(-100)));
  };
  const speakText = (text: string) => {
    try{
      const clean = text.replace(/<[^>]*>/g,"").substring(0,500);
      speechSynthesis.cancel();
      const u = new SpeechSynthesisUtterance(clean);
      u.rate = 0.92; u.pitch = 1.1; u.lang = "en-US";
      const voices = speechSynthesis.getVoices();
      if(voices.length>0){ const f = voices.find(v=>v.name.toLowerCase().includes("female")); u.voice = f || voices[0]; }
      speechSynthesis.speak(u);
    }catch(e){}
  };
  const callGroq = async (prompt:string, memText:string) => {
    if(!groqKey || groqKey.includes("YOUR")) throw new Error("No Groq key");
    const res = await fetch("https://api.groq.com/openai/v1/chat/completions",{
      method:"POST",
      headers:{"Content-Type":"application/json","Authorization":"Bearer "+groqKey},
      body:JSON.stringify({model:"openai/gpt-oss-20b",messages:[{role:"system",content:"You are LARDI SI Brain 1 - Groq. Goal: "+goal+" Memories: "+memText+" Answer plain, no **, no |, no tables."},{role:"user",content:prompt}],max_tokens:400})
    });
    const data = await res.json();
    if(data.error) throw new Error(data.error.message);
    return cleanAIAnswer(data.choices[0].message.content);
  };
  const callGemini = async (prompt:string, memText:string) => {
    if(!geminiKey || geminiKey.includes("YOUR")) throw new Error("No Gemini key");
    const url = `https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=${geminiKey}`;
    const res = await fetch(url,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({contents:[{parts:[{text:"You are LARDI SI Brain 2 - Gemini. Goal: "+goal+" Memories: "+memText+" User: "+prompt+" Answer plain, no **, no |"}]}]})});
    const data = await res.json();
    if(data.error) throw new Error(data.error.message);
    return cleanAIAnswer(data.candidates[0].content.parts[0].text);
  };
  const askSI = async () => {
    if(!q.trim()) return;
    const userQ = q; setQ("");
    const dateStr = new Date().toLocaleDateString('en-US',{month:'short',day:'numeric',timeZone:'Africa/Accra'});
    const timeStr = new Date().toLocaleTimeString('en-US',{hour:'2-digit',minute:'2-digit',second:'2-digit',hour12:true,timeZone:'Africa/Accra'});
    const userItem = { text: userQ, role: "user", time: timeStr, date: dateStr };
    const newChatsTemp = [...chats, userItem];
    setChats(newChatsTemp); save(newChatsTemp, memories);
    if(userQ.toLowerCase().includes("correct is")){
      const correct = cleanAIAnswer(userQ.split("correct is")[1]?.trim() || "");
      if(correct){
        const newMems = [...memories, { q: userQ.slice(0,80), a: correct, t: Date.now() }];
        setMemories(newMems); save(newChatsTemp, newMems);
        setTimeout(()=> setChats(prev=>[...prev, {text: "🧠 LEARNED FOREVER! I now know: "+correct+" Memories: "+newMems.length, role:"ai", time: timeStr, date: dateStr}]), 400);
        return;
      }
    }
    if(userQ.toLowerCase().startsWith("my goal is")){
      const g = cleanAIAnswer(userQ.substring(10).trim()); setGoal(g);
      localStorage.setItem("lardi_si_goal", g);
      setTimeout(()=> setChats(prev=>[...prev, {text: "🎯 GOAL LOCKED! I will remember: "+g, role:"ai", time: timeStr, date: dateStr}]), 400);
      return;
    }
    if(userQ.toLowerCase().includes("picture of")){
      const prompt = userQ.replace(/picture of/gi,"").trim();
      const seed = Math.floor(Math.random()*999999);
      const url = "https://image.pollinations.ai/prompt/"+encodeURIComponent(prompt+", photorealistic 8k, ultra detailed")+"?width=768&height=1024&nologo=true&seed="+seed+"&model=turbo";
      setTimeout(()=> setChats(prev=>[...prev, {text: "✅ SI Generated: "+prompt+" <br><img src='"+url+"' style='width:300px;border-radius:12px;border:3px solid #ffcc00' />", role:"ai", time: timeStr, date: dateStr}]), 800);
      return;
    }
    const thinking = {text: "Mama Lardi is thinking... 💭🧠💙", role:"ai", time: timeStr, date: dateStr};
    setChats(prev=>[...prev, thinking]);
    try{
      const memText = memories.slice(-3).map(m=>m.q+":"+m.a).join(" | ");
      let results:any[] = [];
      try{ const g = await callGroq(userQ, memText); results.push({brain:"Groq ⚡",text:g}); }catch(e){}
      try{ const gm = await callGemini(userQ, memText); results.push({brain:"Gemini 🧠",text:gm}); }catch(e){}
      let finalAns = "";
      if(results.length===0) finalAns = "Akwaaba Boss! I am LARDI SI 🧠 Goal: "+goal+" Memories: "+memories.length+" Add Groq + Gemini keys in Settings to make me super smart! 💛";
      else if(results.length===1) finalAns = results[0].text+"<br><br><small>🧠 Brain: "+results[0].brain+" | Memories: "+memories.length+"</small>";
      else finalAns = results[0].text+"<br><br><small>👥 Swarm Debate: "+results.map(r=>r.brain).join(" + ")+" debated • Picked best! 🧠 Memories: "+memories.length+"</small>";
      setChats(prev=>{ const filtered = prev.filter(c=>!c.text.includes("Mama Lardi is thinking")); const newC = [...filtered, {text: finalAns, role:"ai", time: timeStr, date: dateStr}]; save(newC, memories); return newC; });
    }catch(e){
      setChats(prev=>{ const filtered = prev.filter(c=>!c.text.includes("Mama Lardi is thinking")); return [...filtered, {text: "Akwaaba! I am SI v1 Goal: "+goal+" Memories: "+memories.length, role:"ai", time: timeStr, date: dateStr}]; });
    }
  };
  const saveKeys = () => {
    const gk = (document.getElementById("groqInput") as HTMLInputElement)?.value.trim();
    const gm = (document.getElementById("geminiInput") as HTMLInputElement)?.value.trim();
    if(gk){ setGroqKey(gk); localStorage.setItem("lardi_groq_key", gk); }
    if(gm){ setGeminiKey(gm); localStorage.setItem("lardi_gemini_key", gm); }
    alert("Keys saved! 🧠 Super Intelligent! Groq: "+(gk?"✅":"❌")+" Gemini: "+(gm?"✅":"❌"));
  };

  return (
    <div style={{background:"#000",color:"#fff",height:"100dvh",display:"flex",flexDirection:"column",fontFamily:"Arial"}}>
      <div id="splash" style={{position:"fixed",inset:0,background:"#000",display:"flex",flexDirection:"column",alignItems:"center",justifyContent:"center",zIndex:9999}}>
        <img src="https://i.ibb.co/ycmRvwnK/IMG-20260822-WA6915.jpg" style={{width:140,height:140,borderRadius:"50%",border:"4px solid #ffcc00",boxShadow:"0 0 40px #ffcc00"}} alt="mama" />
        <div style={{color:"#ffcc00",fontSize:28,fontWeight:"bold",marginTop:20}}>🧠 LARDI SI v1</div>
        <div style={{color:"#000",fontSize:11,marginTop:6,background:"#ffcc00",padding:"4px 12px",borderRadius:20,fontWeight:"bold"}}>MAMA LARDI SUPER BRAIN 💙</div>
      </div>
      <div style={{display:"flex",justifyContent:"space-between",padding:"8px 10px",background:"#0a0a0a",borderBottom:"1px solid #222"}}>
        <div style={{display:"flex",gap:8,alignItems:"center"}}><button onClick={()=>setShowSet(true)} style={{background:"#222",color:"#ffcc00",border:"none",width:38,height:38,borderRadius:"50%",cursor:"pointer"}}>☰</button><span style={{background:"linear-gradient(90deg,#ffcc00,#ff8800)",color:"#000",padding:"3px 10px",borderRadius:12,fontSize:10,fontWeight:"bold"}}>SI {groqKey.includes("YOUR")?"": "⚡"} {geminiKey.includes("YOUR")?"": "🧠"} • {memories.length} 🧠</span></div>
        <button onClick={()=>{if(confirm("Exit LARDI SI?")) location.reload()}} style={{background:"#ff2222",color:"#fff",border:"none",padding:"6px 12px",borderRadius:15,fontSize:11,fontWeight:"bold",cursor:"pointer"}}>EXIT ✕</button>
      </div>
      <div style={{display:"flex",alignItems:"center",gap:8,padding:"6px 10px",background:"#0a0a0a",borderBottom:"1px solid #222"}}>
        <img src="https://i.ibb.co/ycmRvwnK/IMG-20260822-WA6915.jpg" style={{width:34,height:34,borderRadius:"50%",border:"2px solid #ffcc00"}} alt="mama"/>
        <div><div style={{fontSize:13,fontWeight:"bold",color:"#ffcc00"}}>Mama Lardi SI 💙 Super Brain</div><div style={{fontSize:10,color:"#00ff88"}}>online • {groqKey.includes("YOUR")?"No Groq":"Groq ⚡"} • {geminiKey.includes("YOUR")?"No Gemini":"Gemini 🧠"}</div></div>
        <div style={{marginLeft:"auto",fontSize:11,color:"#ffcc00",fontWeight:"bold"}}>{liveTime}</div>
      </div>
      <div style={{background:"#0a0a0a",borderBottom:"1px solid #222",padding:"6px 10px",textAlign:"center",fontSize:11,color:"#ffcc00",fontWeight:"bold",display:"flex",justifyContent:"center",gap:10}}>
        <span>{liveDate}</span><span>{liveTime}</span><span>🇬🇭 Kumasi</span><span>🧠 {memories.length}</span>
      </div>
      {showSet && (
        <div style={{position:"fixed",inset:0,background:"#000",zIndex:9998,padding:16,overflowY:"auto"}}>
          <button onClick={()=>setShowSet(false)} style={{background:"#222",color:"#ffcc00",border:"none",width:40,height:40,borderRadius:"50%",fontSize:20,cursor:"pointer"}}>←</button>
          <h2 style={{color:"#ffcc00",margin:"12px 0"}}>🧠 LARDI SI Super Settings</h2>
          <div style={{background:"#1a1a00",border:"2px solid #ffcc00",borderRadius:16,padding:12,fontSize:13,lineHeight:1.8}}>
            🧠 Memories: {memories.length}<br/>💬 Chats: {chats.length}<br/>🎯 Goal: {goal || "Not set"}<br/>⚡ Groq: {groqKey.includes("YOUR")?"❌":"✅"}<br/>🧠 Gemini: {geminiKey.includes("YOUR")?"❌":"✅"}<br/>⏰ {liveDate} • {liveTime}
          </div>
          <div style={{marginTop:12,background:"#111",border:"1px solid #333",borderRadius:12,padding:12}}>
            <div style={{color:"#ffcc00",fontWeight:"bold",fontSize:12}}>🔑 API Keys - Super Intelligent!</div>
            <div style={{fontSize:10,color:"#888",marginTop:4}}>1️⃣ Groq key starts with gsk_ 👇</div>
            <input id="groqInput" placeholder="Groq Key gsk_..." defaultValue={groqKey} style={{width:"100%",padding:12,marginTop:8,borderRadius:10,background:"#222",color:"#fff",border:"1px solid #333",fontSize:12}} />
            <div style={{fontSize:10,color:"#888",marginTop:8}}>2️⃣ Gemini key starts with AIza... 👇 THIS IS GEMINI BOX!</div>
            <input id="geminiInput" placeholder="Gemini Key AIza..." defaultValue={geminiKey} style={{width:"100%",padding:12,marginTop:4,borderRadius:10,background:"#222",color:"#ffcc00",border:"2px solid #ffcc00",fontSize:12}} />
            <button onClick={saveKeys} style={{width:"100%",marginTop:8,padding:12,borderRadius:20,background:"#ffcc00",color:"#000",fontWeight:"bold",border:"none",cursor:"pointer"}}>Save Keys 🔑</button>
          </div>
          <button onClick={()=>setShowSet(false)} style={{width:"100%",marginTop:16,padding:12,borderRadius:25,background:"#222",color:"#fff",border:"none",cursor:"pointer"}}>Close ✕</button>
        </div>
      )}
      <div style={{flex:1,overflowY:"auto",padding:10,background:"#000"}}>
        {chats.length===0 && (
          <>
            <div style={{display:"block",margin:"14px auto",padding:"5px 14px",background:"#1e1e1e",border:"1px solid #ffcc00",color:"#ffcc00",borderRadius:20,fontSize:11,fontWeight:"bold",textAlign:"center",width:"fit-content"}}>TODAY • MAMA LARDI SI 💙</div>
            <div style={{background:"#1a1a00",borderLeft:"3px solid #ffcc00",padding:"12px 36px 24px 12px",borderRadius:"4px 18px 18px 18px",margin:"10px 0",fontSize:14,lineHeight:1.6,position:"relative"}}>
              <button onClick={()=>speakText("Akwaaba Boss! I am Mama Lardi SI Super Intelligent")} style={{position:"absolute",top:5,right:5,width:24,height:24,background:"#222",color:"#ffcc00",border:"1px solid #ffcc00",borderRadius:"50%",fontSize:11,cursor:"pointer"}}>🎤</button>
              Akwaaba Boss! I am Mama Lardi SI SUPER INTELLIGENT 🧠💙<br/><br/>✅ GROQ + GEMINI SWARM!<br/>🧠 Teach: Wrong, correct is...<br/>🎯 Goal: My goal is...<br/>🔑 Tap ☰ to add keys!<br/>🎨 Picture of anything!<br/>Built by Albert 🔥
              <span style={{position:"absolute",bottom:4,right:10,fontSize:9,color:"#666"}}>{liveDate} • {liveTime}</span>
            </div>
          </>
        )}
        {chats.map((c,i)=>(
          <div key={i} style={{margin:"10px 0",padding:"12px 36px 24px 12px",borderRadius: c.role==="user"?"18px 18px 4px 18px":"4px 18px 18px 18px",maxWidth:"85%",background: c.role==="user"?"#2a2a2a":"#1a1a00",marginLeft: c.role==="user"?"auto":"0",borderLeft: c.role==="user"?"none":"3px solid #ffcc00",fontSize:14,lineHeight:1.6,position:"relative",wordWrap:"break-word",whiteSpace:"pre-wrap"}}>
            <button onClick={()=>speakText(c.text)} style={{position:"absolute",top:5,right:5,width:24,height:24,background: c.role==="user"?"#ffcc00":"#222",color: c.role==="user"?"#000":"#ffcc00",border: c.role==="user"?"none":"1px solid #ffcc00",borderRadius:"50%",fontSize:11,cursor:"pointer",display:"flex",alignItems:"center",justifyContent:"center"}}>{c.role==="user"?"🎙️":"🎤"}</button>
            <span dangerouslySetInnerHTML={{__html:c.text}} />
            <span style={{position:"absolute",bottom:4,right:10,fontSize:9,color:"#666",display:"flex",gap:4}}>{c.date || liveDate} • {c.time || liveTime} {c.role==="user" && <span style={{color:"#00aaff",fontWeight:"bold"}}>✓✓</span>}</span>
          </div>
        ))}
        <div ref={chatEndRef} />
      </div>
      <div style={{background:"#111",borderTop:"1px solid #333",padding:8}}>
        <div style={{display:"flex",gap:6}}>
          <input value={q} onChange={e=>setQ(e.target.value)} onKeyDown={e=>{if(e.key==="Enter") askSI()}} placeholder="Ask Mama Lardi SI 💬💙" style={{flex:1,padding:"14px 16px",borderRadius:25,border:"none",background:"#222",color:"#fff",fontSize:16,outline:"none"}} />
          <button onClick={askSI} style={{background:"#ffcc00",color:"#000",border:"3px solid #ffaa00",minWidth:50,width:50,height:50,borderRadius:"50%",fontWeight:"bold",fontSize:22,cursor:"pointer",display:"flex",alignItems:"center",justifyContent:"center"}}>↑</button>
        </div>
      </div>
    </div>
  );
}